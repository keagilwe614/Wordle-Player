def read_dictionary():
    words = []
    while True:
        x = input().strip()
        if x == "###":
            break
        words.append(x)
    return words

def compute_response(target, guess):
    response = []

    for i in range(len(guess)):
        if guess[i] == target[i]:
            response.append(guess[i])  
        elif guess[i] in target:
            response.append(guess[i].lower())  
        else:
            response.append(".") 

    return "".join(response)

dictionary = read_dictionary()
num_guesses = int(input())

history = []
for _ in range(num_guesses):
    guess = input().strip()
    response = input().strip()
    history.append((guess, response))

possible_solutions = []

for word in dictionary:
    valid = True
    for guess, expected in history:
        if compute_response(word, guess) != expected:
            valid = False
            break
    if valid:
        possible_solutions.append(word)
possible_solutions.sort()
for word in possible_solutions:
    print(word)

